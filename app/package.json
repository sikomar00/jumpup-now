{
  "name": "jumpup-now",
  "version": "0.1.2",
  "private": true,
  "description": "생각 과잉 → 착수: 지금 할 일 하나를 시작시키고 실질 작업비율을 측정하는 데스크톱 앱",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "node tests/e2e/smoke.mjs",
    "e2e:checkin": "node tests/e2e/checkin.mjs",
    "e2e:all": "npm run e2e && npm run e2e:checkin && npm run e2e:daily && npm run e2e:idle",
    "e2e:daily": "node tests/e2e/daily.mjs",
    "dist": "electron-vite build && electron-builder --win nsis --x64",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "report": "vite-node tools/report.ts",
    "e2e:idle": "node tests/e2e/idle.mjs",
    "icons": "node tools/make-icons.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.64.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^2.1.0"
  },
  "main": "./out/main/index.js",
  "productName": "JumpUp Now",
  "author": "sikomar00",
  "homepage": "https://github.com/sikomar00/tooMuchThinkerSolution",
  "build": {
    "appId": "com.sikomar00.jumpup-now",
    "productName": "JumpUp Now",
    "copyright": "Copyright (c) sikomar00",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "JumpUp Now",
      "artifactName": "JumpUpNow-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses"
      }
    ]
  }
}
